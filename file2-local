---
# ==============================================================================
# Approval Mandate JSON Files Validation
# 
# This task validates that the required approval mandate files are present
# and contain valid data before proceeding with conversion.
#
# Validation Steps:
#   1. Check if all_cso_json directory exists
#   2. Check if approval_fmandates-lite.json exists
#   3. Check if approval_mandates-implicit.json exists
#   4. Validate Lite approval mandates count > 0
#   5. Validate Implicit approval mandates count > 0
#
# Fails immediately if any validation fails to prevent processing bad data.
# ==============================================================================

- name: "Validate approval mandate JSON files existence"
  shell: |
    set -e
    CSO_DIR="{{ mandates_files_destination }}/input/all_cso_json"
    LITE_FILE="${CSO_DIR}/approval_mandates-lite.json"
    IMPLICIT_FILE="${CSO_DIR}/approval_mandates-implicit.json"
    
    echo "==== Validating approval mandate files ===="
    echo "Validation directory: ${CSO_DIR}"
    
    # Check if all_cso_json directory exists
    if [ ! -d "${CSO_DIR}" ]; then
      echo "ERROR: Directory ${CSO_DIR} does not exist"
      echo "##vso[task.logissue type=error] Missing all_cso_json directory in extracted archive."
      exit 1
    fi
    echo "✔ Found directory: all_cso_json"
    
    # Check if Lite file exists
    if [ ! -f "${LITE_FILE}" ]; then
      echo "ERROR: File approval_mandates-lite.json is missing"
      echo "##vso[task.logissue type=error] Missing approval_mandates-lite.json file. Pipeline failed."
      exit 1
    fi
    echo "✔ Found: approval_mandates-lite.json"
    
    # Check if Implicit file exists
    if [ ! -f "${IMPLICIT_FILE}" ]; then
      echo "ERROR: File approval_mandates-implicit.json is missing"
      echo "##vso[task.logissue type=error] Missing approval_mandates-implicit.json file. Pipeline failed."
      exit 1
    fi
    echo "✔ Found: approval_mandates-implicit.json"
    
    echo "✔ All approval mandate files are present"
  register: approval_files_existence_check
  args:
    executable: /bin/bash
  failed_when: approval_files_existence_check.rc != 0

- debug:
    msg: "{{ approval_files_existence_check.stdout_lines }}"

- name: "Validate approval mandate record counts"
  shell: |
    set -e
    CSO_DIR="{{ mandates_files_destination }}/input/all_cso_json"
    
    echo "==== Validating approval mandate record counts ===="
    
    # Change to CSO directory
    cd "${CSO_DIR}"
    
    # Count Lite approval mandates
    LITE_COUNT=$(grep -c '"type": "Lite"' approval_mandates-lite.json 2>/dev/null || echo "0")
    echo "Lite approval mandates count: ${LITE_COUNT}"
    
    if [ "${LITE_COUNT}" -eq 0 ]; then
      echo "ERROR: No Lite approval mandates found in approval_mandates-lite.json"
      echo "##vso[task.logissue type=error] Zero Lite approval mandates found. Pipeline failed."
      exit 1
    fi
    echo "✔ Lite approval mandates: ${LITE_COUNT} records"
    
    # Count Implicit approval mandates
    IMPLICIT_COUNT=$(grep -c '"type": "Implicit"' approval_mandates-implicit.json 2>/dev/null || echo "0")
    echo "Implicit approval mandates count: ${IMPLICIT_COUNT}"
    
    if [ "${IMPLICIT_COUNT}" -eq 0 ]; then
      echo "ERROR: No Implicit approval mandates found in approval_mandates-implicit.json"
      echo "##vso[task.logissue type=error] Zero Implicit approval mandates found. Pipeline failed."
      exit 1
    fi
    echo "✔ Implicit approval mandates: ${IMPLICIT_COUNT} records"
    
    echo "==== Approval Mandate Validation PASSED ===="
    echo "Summary: Lite=${LITE_COUNT}, Implicit=${IMPLICIT_COUNT}"
  register: approval_counts_validation
  args:
    executable: /bin/bash
  failed_when: approval_counts_validation.rc != 0

- debug:
    msg: "{{ approval_counts_validation.stdout_lines }}"
